              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          {
            "name": "minimum_revision",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
