    "/api/v1/tenants/{tenant_id}/applications/{application_id}/relationships": {
      "get": {
        "tags": [
          "Applications"
        ],
        "summary": "List directed relationships from an application",
        "description": "relationship_revision, expected_relationship_revision, and minimum_revision use actor-visible relationship event counts: each add or remove event counts only when its target is currently readable by the actor. Hidden target events do not create revision gaps. minimum_revision is a nonnegative read-your-own-writes lower bound; the endpoint returns the current actor-visible relationship snapshot when its revision meets the requested minimum. Otherwise it returns a retryable 409 with the requested and current actor-visible relationship revisions. It never returns a lower snapshot or reconstructs an exact historical revision. Continuation cursors bind tenant, source, actor, page size, visible revision, and the filtered active-row fingerprint; hidden-only updates preserve the cursor, while visible add/remove activity invalidates it.",
        "operationId": "listApplicationRelationships",
        "parameters": [
          {
            "name": "tenant_id",
            "in": "path",
